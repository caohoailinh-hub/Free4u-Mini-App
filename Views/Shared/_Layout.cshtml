<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phần Mềm Kế Toán</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
            body {
                font-size: 0.9rem;
                background-color: #f8f9fa;
                overflow-x: hidden;
            }

            /* HEADER DOCK TOP (Cố định trên cùng, tràn 100% chiều ngang) */
            .top-navbar-company {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 48px;
                background-color: #008f5d !important; /* Màu xanh lá MISA */
                z-index: 1050;
                color: #fff;
            }

            /* SIDEBAR CỐ ĐỊNH BÊN TRÁI (Nằm dưới Header) */
            #sidebar {
                width: 250px;
                min-height: calc(100vh - 48px);
                background: #212529;
                color: #fff;
                transition: all 0.3s;
                position: fixed;
                top: 48px;
                left: 0;
                z-index: 1000;
            }

                #sidebar .nav-link {
                    color: rgba(255,255,255,.75);
                    padding: 10px 16px;
                    margin-bottom: 4px;
                    border-radius: 4px;
                }

                    #sidebar .nav-link:hover, #sidebar .nav-link.active {
                        color: #fff;
                        background: #00a86b !important;
                    }

                    #sidebar .nav-link i {
                        width: 25px;
                    }

            /* KHUNG NỘI DUNG CHÍNH (Được đẩy sang phải và xuống dưới Header) */
            .content-wrapper {
                width: calc(100% - 250px);
                margin-left: 250px;
                margin-top: 48px;
                min-height: calc(100vh - 48px);
                display: flex;
                flex-direction: column;
                overflow-x: hidden;
            }

            /* Hiệu ứng ẩn/hiện nút Thao tác (Sửa/Xoá) khi rê chuột vào dòng bảng */
            .action-buttons {
                opacity: 0;
                visibility: hidden;
                transition: opacity 0.2s ease-in-out, visibility 0.2s ease-in-out;
            }

            tbody tr:hover .action-buttons {
                opacity: 1;
                visibility: visible;
            }
    </style>
</head>
<body class="p-0 m-0">

    <!-- 1. TOP HEADER DOCK TOP (Tên công ty & Thông tin hệ thống) -->
    <nav class="navbar navbar-dark top-navbar-company px-3 shadow-sm">
        <div class="container-fluid px-0">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-link text-white p-0 text-decoration-none fs-5"><i class="fa-solid fa-arrow-left"></i></button>
                
                <span class="text-white fw-semibold fs-6 ms-2">CÔNG TY TNHH THỦY SẢN HIỆP HUY</span>
                <span class="badge text-white border border-light rounded-pill px-3 py-1 ms-2 font-monospace small" style="background-color: rgba(255,255,255,0.2) !important;">
                    <i class="fa-regular fa-circle-dot me-1 small"></i> HIEP-HUY_2026_TT99-V2
                </span>
                <div id="defaultToolbarActions" class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" title="Làm mới"><i class="fa-solid fa-rotate"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" title="Xuất Excel"><i class="fa-solid fa-file-excel"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" title="Tùy chỉnh cột"><i class="fa-solid fa-gear"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" title="Bộ lọc"><i class="fa-solid fa-filter"></i></button>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <span class="text-white small">Năm tài chính: <strong>2026</strong></span>
                <ul class="navbar-nav flex-row">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white px-2" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-bell"></i> <span class="badge bg-danger rounded-pill">3</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><a class="dropdown-item" href="#">Hóa đơn mua hàng #HD01 chưa thanh toán</a></li>
                            <li><a class="dropdown-item" href="#">Cảnh báo số quỹ tiền mặt âm</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="d-flex">
        <!-- 2. SIDEBAR MENU CỐ ĐỊNH BÊN TRÁI -->
        <nav id="sidebar" class="d-flex flex-column p-3">
            <a href="/Dashboard/Index" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none ajax-link">
                <i class="fa-solid fa-calculator fa-2x me-2 text-success"></i>
                <span class="fs-5 fw-bold">Free4U Mini App</span>
            </a>
            <hr class="text-secondary">
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="/Dashboard/Index" class="nav-link ajax-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i> Tổng quan
                    </a>
                </li>
                <li>
                    <a href="/Cash/Index" class="nav-link ajax-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cash" ? "active" : "")">
                        <i class="fa-solid fa-wallet"></i> Tiền mặt
                    </a>
                </li>
                <li>
                    <a href="/Bank/Index" class="nav-link ajax-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bank" ? "active" : "")">
                        <i class="fa-solid fa-building-columns"></i> Tiền gửi ngân hàng
                    </a>
                </li>
                <li>
                    <a href="/Purchase/Index" class="nav-link ajax-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchase" ? "active" : "")">
                        <i class="fa-solid fa-cart-shopping"></i> Mua hàng
                    </a>
                </li>
                <li>
                    <a href="/Sales/Index" class="nav-link ajax-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")">
                        <i class="fa-solid fa-cash-register"></i> Bán hàng
                    </a>
                </li>
                <li>
                    <a href="/Report/Index" class="nav-link ajax-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")">
                        <i class="fa-solid fa-file-invoice-dollar"></i> Báo cáo tài chính
                    </a>
                </li>
            </ul>
            <hr class="text-secondary">
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="https://github.com/mdo.png" alt="" width="32" height="32" class="rounded-circle me-2">
                    <strong>Kế toán trưởng</strong>
                </a>
                <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                    <li><a class="dropdown-item" href="#">Cài đặt hệ thống</a></li>
                    <li><a class="dropdown-item" href="#">Hồ sơ công ty</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#">Đăng xuất</a></li>
                </ul>
            </div>
        </nav>

        <!-- 3. MAIN CONTENT AREA -->
        <div class="content-wrapper">
            <!-- KHUNG HIỂN THỊ NỘI DUNG ĐỘNG (AJAX CONTAINER) -->
            <main class="p-3 flex-grow-1 position-relative" id="main-container">

    <!-- Vùng nội dung thay đổi khi chuyển menu -->
    <div id="page-content">
        @RenderBody()
    </div>

    <!-- Spinner đặt riêng, không bị xóa khi tải nội dung AJAX -->
    <div id="loading-spinner"
         class="d-none justify-content-center align-items-center position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75"
         style="z-index: 1050;">

        <div class="text-center">
            <div class="spinner-border text-success"
                 style="width: 3rem; height: 3rem;"
                 role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>

            <div class="mt-2 text-muted fw-semibold">
                Đang xử lý dữ liệu kế toán...
            </div>
        </div>
    </div>

</main>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery Core -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- XỬ LÝ AJAX, LOADING & EVENT DELEGATION CHO CHECK ALL -->
    <script>
            
$(function () {

    // =====================================================
    // 1. CHECK ALL - EVENT DELEGATION
    // =====================================================

    $(document).on("change", "#selectAll", function () {
        const isChecked = $(this).prop("checked");

        $("#page-content .row-checkbox").prop("checked", isChecked);
    });

    $(document).on("change", "#page-content .row-checkbox", function () {
        const totalRows = $("#page-content .row-checkbox").length;
        const checkedRows = $("#page-content .row-checkbox:checked").length;

        $("#page-content #selectAll").prop(
            "checked",
            totalRows > 0 && totalRows === checkedRows
        );
    });


    // =====================================================
    // 2. HÀM CHẠY SCRIPT CỦA VIEW ĐƯỢC TẢI BẰNG AJAX
    // =====================================================

    function executeViewScripts(container) {

        const scripts = container.querySelectorAll("script");

        scripts.forEach(oldScript => {

            const newScript = document.createElement("script");

            // Giữ nguyên thuộc tính script
            Array.from(oldScript.attributes).forEach(attr => {
                newScript.setAttribute(attr.name, attr.value);
            });

            // Script inline
            if (!oldScript.src) {
                newScript.textContent = oldScript.textContent;
                oldScript.parentNode.replaceChild(newScript, oldScript);
            }
            // Script bên ngoài
            else {
                newScript.src = oldScript.src;
                oldScript.parentNode.replaceChild(newScript, oldScript);
            }

        });
    }


    // =====================================================
    // 3. HÀM TẢI TRANG AJAX
    // =====================================================

    function loadPage(url, addHistory = true) {

        if (!url || url === "#") return;

        $("#loading-spinner")
            .removeClass("d-none")
            .addClass("d-flex");

        $.ajax({
            url: url,
            type: "GET",
            dataType: "html",

            success: function (response) {

                const parser = new DOMParser();

                const doc = parser.parseFromString(response, "text/html");

                const newPageContent = doc.querySelector("#page-content");

                const oldPageContent = document.getElementById("page-content");

                if (newPageContent && oldPageContent) {

                    // Lấy nội dung trang mới
                    oldPageContent.innerHTML = newPageContent.innerHTML;

                    // Chạy các script của trang mới
                    executeViewScripts(oldPageContent);

                }
                else {

                    // Trường hợp server trả về View không có page-content
                    const newMain = doc.querySelector("#main-container");

                    if (newMain && oldPageContent) {
                        oldPageContent.innerHTML = newMain.innerHTML;
                        executeViewScripts(oldPageContent);
                    }
                    else {
                        window.location.href = url;
                        return;
                    }
                }

                // Cập nhật tiêu đề trang
                const newTitle = doc.querySelector("title");

                if (newTitle) {
                    document.title = newTitle.textContent;
                }

                // Cập nhật menu đang chọn
                $("#sidebar .nav-link").removeClass("active");

                $('#sidebar a.ajax-link[href="' + url + '"]')
                    .addClass("active");

                // Cập nhật URL trình duyệt
                if (addHistory) {
                    window.history.pushState(
                        { path: url },
                        "",
                        url
                    );
                }
            },

            error: function () {
                window.location.href = url;
            },

            complete: function () {
                $("#loading-spinner")
                    .removeClass("d-flex")
                    .addClass("d-none");
            }
        });
    }


    // =====================================================
    // 4. CLICK MENU SIDEBAR
    // =====================================================

    $("#sidebar").on("click", "a.ajax-link", function (e) {

        const url = $(this).attr("href");

        if (!url || url === "#" || url.startsWith("javascript")) {
            return;
        }

        e.preventDefault();

        loadPage(url, true);
    });


    // =====================================================
    // 5. NÚT BACK / FORWARD CỦA TRÌNH DUYỆT
    // =====================================================

    $(window).on("popstate", function (e) {

        const state = e.originalEvent.state;

        if (state && state.path) {
            loadPage(state.path, false);
        }
        else {
            window.location.reload();
        }

    });

});

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>